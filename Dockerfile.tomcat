# ========== 阶段一：Docker容器化 ==========
# Tomcat 10.1 = Servlet 6.0 / JSP 3.1，只提供 jakarta.servlet.*，与源码的 jakarta 迁移配套
FROM tomcat:10.1-jdk17-temurin

# 删除 Tomcat 默认的示例应用
RUN rm -rf /usr/local/tomcat/webapps/*

# 复制 WAR 包
# config.local.properties 里是 ${VAR:-default} 占位符，由 config.Config 在运行期解析
# （不再需要构建期 envsubst 替换）
COPY target/software-group.war /usr/local/tomcat/webapps/software-group.war

# 配置 JVM 参数
ENV CATALINA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC -XX:+UseStringDeduplication"

# 暴露端口
EXPOSE 8080

# 启动命令
CMD ["catalina.sh", "run"]
