# Git 版本控制
.git
.gitignore

# Maven 构建产物（排除 target/ 但保留 WAR 文件）
target/
!target/*.war
pom.xml.tag
pom.xml.releaseBackup
pom.xml.clover
pom.xml.release

# IDE 配置
.idea/
*.iml
.vscode/
.eclipse/
*.class

# 日志文件
*.log
logs/

# 操作系统文件
.DS_Store
Thumbs.db

# 项目文档（不需要打包进镜像）
docs/
*.md
!README.md

# 测试代码（不需要打包进镜像）
src/test/

# Docker 相关文件（不需要打包进镜像）
Dockerfile*
docker-compose*
.dockerignore

# 临时文件和备份
*~
*.swp
*.swo
*~
