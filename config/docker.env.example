# ============================================
# Docker 环境变量配置文件
# ============================================
# 使用方式：
# 1. 复制此文件为 .env 放在项目根目录
# 2. 或使用 docker-compose --env-file 指定此文件
# 3. 修改其中的值以适应你的环境
#
# 语法格式：KEY=value（无引号，等号两边无空格）
# 注释以 # 开头

# ============================================
# MySQL 数据库配置
# ============================================
# MySQL root 密码（生产环境必须修改！）
MYSQL_ROOT_PASSWORD=root123

# 自动创建的数据库名
MYSQL_DATABASE=software_group

# MySQL 普通用户（与 root 相同）
MYSQL_USER=root

# MySQL 密码
MYSQL_PASSWORD=root123

# MySQL 端口（宿主机访问端口）
MYSQL_PORT=3306

# ============================================
# 应用配置
# ============================================
# 应用端口（宿主机访问端口）
APP_PORT=8080

# ============================================
# HikariCP 连接池配置
# ============================================
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5

# ============================================
# 文件存储配置
# ============================================
# Docker 容器内路径，与 docker-compose.yml 中的 volumes 挂载点一致
UPLOAD_BASE_DIR=/usr/local/tomcat/webapps/localstorage

# ============================================
# 会话配置
# ============================================
SESSION_TIMEOUT=30

# ============================================
# AI 服务配置
# ============================================
# AI 服务提供商：minimax / volcengine / wenxin / qwen / openai
AI_PROVIDER=minimax

# AI API Key（从对应服务商获取）
# MiniMax: https://platform.minimaxi.com/
# Volcano: https://volcengine.com/
# Wenxin: https://wenxin.baidu.com/
# Qwen: https://qwen.com/
AI_API_KEY=your-api-key-here

# AI API URL（不同服务商地址不同）
AI_API_URL=https://api.minimaxi.com/v1/chat/completions

# AI 模型名称
AI_MODEL=MiniMax-M2.7

# ============================================
# DES 加密配置
# ============================================
# 生产环境必须修改！默认密钥不安全
# 格式：任意字符串，Java Properties 会自动处理
DES_KEY=(^&%gasie_%^)

# ============================================
# Redis 缓存配置
# ============================================
# Redis 端口（宿主机访问端口）
REDIS_PORT=6379

# Redis 密码
REDIS_PASSWORD=redis123

# ============================================
# RabbitMQ 消息队列配置
# ============================================
# RabbitMQ AMQP 端口（宿主机访问端口）
RABBITMQ_PORT=5672

# RabbitMQ 管理界面端口
RABBITMQ_MANAGE_PORT=15672

# RabbitMQ 用户名
RABBITMQ_USER=admin

# RabbitMQ 密码
RABBITMQ_PASSWORD=admin123

# ============================================
# Nginx 反向代理配置
# ============================================
# Nginx HTTP 端口
NGINX_PORT=80

# ============================================
# 阶段三：Nacos 服务注册中心配置
# ============================================
# Nacos HTTP 端口（宿主机访问端口）
NACOS_PORT=8848

# Nacos gRPC 端口（客户端连接使用）
NACOS_GRPC_PORT=9848

# Nacos 命名空间（开发环境使用 public）
NACOS_NAMESPACE=public

# ============================================
# 阶段三：Sentinel 熔断器配置
# ============================================
# Sentinel Dashboard 端口（宿主机访问端口）
SENTINEL_PORT=8858

# ============================================
# 阶段三：MinIO 对象存储配置
# ============================================
# MinIO API 端口（宿主机访问端口）
MINIO_PORT=9000

# MinIO Console 管理界面端口
MINIO_CONSOLE_PORT=9001

# MinIO Access Key（用户名，生产环境必须修改！）
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key（密码，生产环境必须修改！）
MINIO_SECRET_KEY=minioadmin123

# MinIO 存储桶名称
MINIO_BUCKET=software-group

# ============================================
# Java JVM 配置（可选）
# ============================================
# CATALINA_OPTS="-Xmx512m -Xms256m -XX:+UseG1GC"
